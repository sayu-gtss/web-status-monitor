# ===========================
# Websites to monitor
# ===========================
# Comma-separated list of URLs (no spaces between)
WEBSITES_TO_MONITOR=https://example.com,https://your-other-site.com

# ===========================
# Check Frequency
# ===========================
# Use one of the two below (SECONDS takes priority if both are set)
CHECK_INTERVAL_SECONDS=60
# CHECK_INTERVAL_MINUTES=10

# ===========================
# Request Settings
# ===========================
REQUEST_TIMEOUT_SECONDS=10
SLOW_THRESHOLD_SECONDS=1.5

# ===========================
# Email Alerts (Gmail SMTP)
# ===========================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sender-email@gmail.com
# Use a Gmail App Password (not your real password)
# Generate one at: Google Account > Security > 2-Step Verification > App Passwords
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
NOTIFICATION_RECEIVER=your-receiver-email@gmail.com

# ===========================
# Google Sheets Logging
# ===========================
# The ID in your sheet URL: https://docs.google.com/spreadsheets/d/SHEET_ID/edit
GOOGLE_SHEET_ID=your-google-sheet-id
# Path to your service account credentials JSON file
GOOGLE_CREDS_FILE=storage/credentials.json

# ===========================
# Twilio Voice Call Alerts
# ===========================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890
TWILIO_TO_NUMBER=+0987654321
# Optional: public URL to a custom MP3/WAV file to play during the call
# If left empty, a text-to-speech message is used automatically
TWILIO_PLAY_URL=
